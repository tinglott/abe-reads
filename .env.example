# Copy to .env and fill in — both services are OPTIONAL.
# The app is fully playable offline with none of these set.

# Progress sync (supabase.com). Enable anonymous sign-ins in Auth → Providers.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI bonus questions (huggingface.co/settings/tokens)
EXPO_PUBLIC_HF_TOKEN=
