{
  "expo": {
    "name": "Abe Reads",
    "slug": "abe-reads",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "abereads",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.abereads.app",
      "appleTeamId": "",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Abe Reads does not record audio; this is unused.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8E7"
      },
      "package": "com.abereads.app",
      "edgeToEdgeEnabled": true,
      "permissions": ["INTERNET"],
      "playStoreName": "Abe Reads - Reading Comprehension"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "kotlinVersion": "2.1.20",
            "enableProguardInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "hfToken": "",
      "eas": {
        "projectId": ""
      }
    },
    "runtimeVersion": "1.0.0"
  }
}
